{
  "mcpServers": {
    "maind": {
      "command": "maind",
      "args": [
        "mcp",
        "--scope",
        "project:proxyma"
      ]
    },
    "perplexity": {
      "command": "<HOME>/projects/packages/perplexity-web-mcp/start.sh",
      "args": [
        "--pool=default"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}

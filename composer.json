{
    "name": "axiomasoft/proxyma-workspace",
    "description": "Private development workspace for Proxyma 0.1",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {"type": "path", "url": "packages/core", "options": {"symlink": true, "versions": {"axiomasoft/proxyma": "dev-main"}}},
        {"type": "path", "url": "packages/filament", "options": {"symlink": true, "versions": {"axiomasoft/proxyma-filament": "dev-main"}}}
    ],
    "require": {"php": "^8.4", "axiomasoft/proxyma": "dev-main", "axiomasoft/proxyma-filament": "dev-main"},
    "require-dev": {
        "laravel/pao": "1.1.5",
        "laravel/pint": "1.32.1",
        "orchestra/testbench": "11.3.0",
        "pestphp/pest": "5.3.5",
        "phpstan/phpstan": "2.3.5"
    },
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "config": {"sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}

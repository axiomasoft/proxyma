{
    "name": "axiomasoft/proxyma-core",
    "description": "Proxyma core — governed egress routing, quota admission, health, and policy runtime for Laravel.",
    "type": "library",
    "license": "proprietary",
    "replace": {
        "axiomasoft/proxyma": "self.version"
    },
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "axiomasoft/packman-plugins": "^0.1.2",
        "axiomasoft/packman-schema": "^0.1",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0",
        "psr/log": "^3.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Proxyma\\": "src/"
        },
        "files": [
            "src/aliases.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Proxyma\\Laravel\\ProxymaServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "core",
            "stability": "alpha",
            "error-prefix": "proxyma",
            "owns": [
                "Application",
                "Configuration",
                "Contracts",
                "Database",
                "Diagnostics",
                "Domain",
                "Errors",
                "Infrastructure",
                "Laravel",
                "Panels",
                "Plugins"
            ]
        }
    }
}

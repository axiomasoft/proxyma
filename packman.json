{
    "schema_version": 1,
    "name": "axiomasoft/proxyma-monorepo",
    "profile": "laravel-package",
    "php": "^8.4",
    "phpstan_level": "max",
    "provider_max_lines": 80,
    "packages": [
        {
            "name": "axiomasoft/proxyma-core",
            "path": "packages/core",
            "namespace": "Proxyma\\",
            "profile": "laravel-package",
            "layer": "L2",
            "type": "domain",
            "owns": [
                "Application",
                "Configuration",
                "Contracts",
                "Database",
                "Diagnostics",
                "Domain",
                "Errors",
                "Infrastructure",
                "Laravel",
                "Panels",
                "Plugins"
            ]
        },
        {
            "name": "axiomasoft/proxyma-filament",
            "path": "packages/filament",
            "namespace": "Proxyma\\Filament\\",
            "profile": "laravel-package",
            "layer": "L3",
            "type": "integration",
            "owns": [
                "Actions",
                "Pages",
                "Queries",
                "Registrars",
                "Resources",
                "Schemas"
            ]
        }
    ],
    "gates": {
        "strict_ownership": true,
        "provider_size_limit": 80,
        "disallow_internal_cross_imports": true,
        "require_api_manifest": true,
        "error_urn_prefix": "urn:packman:problem:",
        "min_coverage": 90,
        "internal_ownership_groups": {
            "proxyma": [
                "axiomasoft/proxyma-core",
                "axiomasoft/proxyma-filament"
            ]
        }
    }
}
